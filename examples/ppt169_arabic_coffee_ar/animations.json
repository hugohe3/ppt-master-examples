{
  "version": 1,
  "defaults": {
    "transition": {"effect": "fade", "duration": 0.4},
    "animation": {"trigger": "after-previous"}
  },
  "slides": {
    "01_cover": {
      "groups": {
        "cover-title": {"effect": "entrance_wipe", "effect_options": {"direction": "right"}, "order": 1, "duration": 0.8},
        "cover-hook": {"effect": "entrance_fade", "order": 2, "duration": 0.5},
        "cover-badge": {"effect": "entrance_fade", "order": 3, "duration": 0.4}
      }
    },
    "02_hospitality": {
      "transition": {"effect": "push", "effect_options": {"direction": "right"}, "duration": 0.6},
      "groups": {
        "occasions": {"effect": "entrance_wipe", "effect_options": {"direction": "right"}, "order": 1, "duration": 1.2},
        "peace-line": {"effect": "entrance_fade", "order": 2, "duration": 0.5}
      }
    },
    "03_six_stages": {
      "transition": {"effect": "push", "effect_options": {"direction": "right"}, "duration": 0.6},
      "groups": {
        "process": {"effect": "entrance_wipe", "effect_options": {"direction": "right"}, "order": 1, "duration": 1.6},
        "roast-disc": {"effect": "entrance_zoom", "order": 2, "duration": 0.5}
      }
    },
    "04_roasting": {
      "transition": {"effect": "morph", "effect_options": {"morph_by": "object"}, "duration": 0.9},
      "morph": {"from": "03_six_stages", "pairs": {"roast": {"from": "roast-disc", "to": "roast-disc"}}},
      "groups": {
        "color-shift": {"effect": "entrance_wipe", "effect_options": {"direction": "right"}, "order": 1, "duration": 0.9}
      }
    },
    "05_hearth": {
      "groups": {
        "hearth-before": {"effect": "entrance_fade", "order": 1, "duration": 0.5},
        "hearth-shift": {"effect": "entrance_wipe", "effect_options": {"direction": "right"}, "order": 2, "duration": 0.5},
        "hearth-after": {"effect": "entrance_fade", "order": 3, "duration": 0.5}
      }
    },
    "06_three_dallahs": {
      "groups": {
        "dallah-photo": {"effect": "entrance_fade", "order": 1, "duration": 0.6},
        "dallah-legend": {"effect": "entrance_wipe", "effect_options": {"direction": "up"}, "order": 2, "duration": 0.9}
      }
    },
    "07_roast_regions": {
      "groups": {
        "roast-regions": {"effect": "entrance_fade", "order": 1, "duration": 0.6}
      }
    },
    "08_serving_order": {
      "transition": {"effect": "push", "effect_options": {"direction": "right"}, "duration": 0.6},
      "groups": {
        "station-1": {"effect": "entrance_fade", "order": 1, "duration": 0.35},
        "station-2": {"effect": "entrance_fade", "order": 2, "duration": 0.35},
        "station-3": {"effect": "entrance_fade", "order": 3, "duration": 0.35},
        "station-4": {"effect": "entrance_fade", "order": 4, "duration": 0.35},
        "station-5": {"effect": "entrance_fade", "order": 5, "duration": 0.35},
        "finjan-disc": {"effect": "entrance_zoom", "order": 6, "duration": 0.45},
        "station-6": {"effect": "entrance_fade", "order": 7, "duration": 0.35}
      }
    },
    "09_cup_shake": {
      "transition": {"effect": "morph", "effect_options": {"morph_by": "object"}, "duration": 1.0},
      "morph": {"from": "08_serving_order", "pairs": {"finjan": {"from": "finjan-disc", "to": "finjan-disc"}}},
      "groups": {
        "shake-statement": {"effect": "entrance_fly", "effect_options": {"direction": "right"}, "order": 1, "duration": 0.7}
      }
    },
    "10_unesco_timeline": {
      "transition": {"effect": "push", "effect_options": {"direction": "right"}, "duration": 0.6},
      "groups": {
        "time-spine": {"effect": "entrance_wipe", "effect_options": {"direction": "right"}, "order": 1, "duration": 0.8},
        "year-2015": {"effect": "entrance_fade", "order": 2, "duration": 0.45},
        "year-2022": {"effect": "entrance_fade", "order": 3, "duration": 0.45},
        "year-2024": {"effect": "entrance_fade", "order": 4, "duration": 0.45}
      }
    },
    "11_khawlani": {
      "groups": {
        "khawlani-steps": {"effect": "entrance_wipe", "effect_options": {"direction": "up"}, "order": 1, "duration": 1.0},
        "khawlani-heritage": {"effect": "entrance_fade", "order": 2, "duration": 0.6}
      }
    },
    "12_year_of_coffee": {
      "groups": {
        "year-arch": {"effect": "entrance_fade", "order": 1, "duration": 0.7},
        "year-launch": {"effect": "entrance_fade", "order": 2, "duration": 0.4},
        "year-closing": {"effect": "entrance_fade", "order": 3, "duration": 0.4}
      }
    },
    "13_production_chart": {
      "transition": {"effect": "push", "effect_options": {"direction": "right"}, "duration": 0.6},
      "groups": {
        "coffee-output": {"effect": "entrance_wipe", "effect_options": {"direction": "right"}, "order": 1, "duration": 1.2}
      }
    },
    "14_jazan_mountains": {
      "groups": {
        "kpi-farms": {"effect": "entrance_fade", "order": 1, "duration": 0.45},
        "kpi-trees": {"effect": "entrance_fade", "order": 2, "duration": 0.45},
        "governorates": {"effect": "entrance_wipe", "effect_options": {"direction": "right"}, "order": 3, "duration": 0.7}
      }
    },
    "15_closing_sources": {
      "transition": {"effect": "fade", "duration": 0.8},
      "groups": {
        "takeaway": {"effect": "entrance_fade", "order": 1, "duration": 0.8},
        "sources": {"effect": "entrance_wipe", "effect_options": {"direction": "up"}, "order": 2, "duration": 0.8}
      }
    }
  }
}
