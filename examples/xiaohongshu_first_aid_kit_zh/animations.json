{
  "version": 1,
  "defaults": {
    "animation": { "trigger": "after-previous", "duration": 0.4 }
  },
  "slides": {
    "01_cover": {
      "groups": {
        "cover-title": { "effect": "entrance_fade", "order": 1, "duration": 0.6 },
        "cover-hook": { "effect": "entrance_rise_up", "order": 2, "duration": 0.5, "delay": 0.1 },
        "cover-sub": { "effect": "entrance_fade", "order": 3, "duration": 0.4 }
      }
    },
    "02_four_categories": {
      "groups": {
        "page-title": { "effect": "entrance_fade", "order": 1, "duration": 0.45 },
        "page-lead": { "effect": "entrance_fade", "order": 2, "duration": 0.4 },
        "cat-bandage": { "effect": "entrance_zoom", "order": 3, "duration": 0.4 },
        "cat-antiseptic": { "effect": "entrance_zoom", "order": 4, "duration": 0.4 },
        "cat-medicine": { "effect": "entrance_zoom", "order": 5, "duration": 0.4 },
        "cat-tools": { "effect": "entrance_zoom", "order": 6, "duration": 0.4 },
        "category-note": { "effect": "entrance_fade", "order": 7, "duration": 0.4 }
      }
    },
    "03_bandage_antiseptic": {
      "transition": { "effect": "morph", "effect_options": { "morph_by": "object" }, "duration": 0.8 },
      "morph": {
        "from": "02_four_categories",
        "pairs": {
          "rail-marker": { "from": "rail-marker", "to": "rail-marker" },
          "cat-a": { "from": "cat-bandage", "to": "band-bandage" },
          "cat-b": { "from": "cat-antiseptic", "to": "band-antiseptic" }
        }
      },
      "groups": {
        "page-title": { "effect": "entrance_fade", "order": 1, "duration": 0.45 },
        "page-lead": { "effect": "entrance_fade", "order": 2, "duration": 0.4 },
        "page-note": { "effect": "entrance_fade", "order": 3, "duration": 0.4, "delay": 0.3 }
      }
    },
    "04_medicine_tools": {
      "transition": { "effect": "morph", "effect_options": { "morph_by": "object" }, "duration": 0.8 },
      "morph": {
        "from": "03_bandage_antiseptic",
        "pairs": {
          "rail-marker": { "from": "rail-marker", "to": "rail-marker" },
          "cat-a": { "from": "band-bandage", "to": "band-medicine" },
          "cat-b": { "from": "band-antiseptic", "to": "band-tools" }
