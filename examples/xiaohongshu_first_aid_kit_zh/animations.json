      "groups": {
        "page-title": { "effect": "entrance_fade", "order": 1, "duration": 0.45 },
        "page-lead": { "effect": "entrance_fade", "order": 2, "duration": 0.4 },
        "old-drugs-figure": { "effect": "entrance_fade", "order": 3, "duration": 0.4 },
        "ban-item-mercurochrome": { "effect": "entrance_wipe", "effect_options": { "direction": "right" }, "order": 4, "duration": 0.35 },
        "ban-item-gentian": { "effect": "entrance_wipe", "effect_options": { "direction": "right" }, "order": 5, "duration": 0.35 },
        "ban-item-alcohol": { "effect": "entrance_wipe", "effect_options": { "direction": "right" }, "order": 6, "duration": 0.35 },
