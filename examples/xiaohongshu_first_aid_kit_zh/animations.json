        "minor-header": { "effect": "entrance_wipe", "effect_options": { "direction": "right" }, "order": 5, "duration": 0.35 },
        "minor-step-1": { "effect": "entrance_fade", "order": 6, "duration": 0.3 },
        "minor-step-2": { "effect": "entrance_fade", "order": 7, "duration": 0.3 },
        "minor-step-3": { "effect": "entrance_fade", "order": 8, "duration": 0.3 },
        "minor-step-4": { "effect": "entrance_fade", "order": 9, "duration": 0.3 },
        "p07-edge-major": { "effect": "entrance_wipe", "effect_options": { "direction": "right" }, "order": 10, "duration": 0.3, "delay": 0.2 },
        "major-header": { "effect": "entrance_wipe", "effect_options": { "direction": "right" }, "order": 11, "duration": 0.35 },
        "major-step-1": { "effect": "entrance_fade", "order": 12, "duration": 0.3 },
        "major-step-2": { "effect": "entrance_fade", "order": 13, "duration": 0.3 },
        "major-step-3": { "effect": "entrance_fade", "order": 14, "duration": 0.3 },
        "major-step-4": { "effect": "entrance_fade", "order": 15, "duration": 0.3 },
        "major-step-5": { "effect": "entrance_fade", "order": 16, "duration": 0.3 },
        "flow-notes": { "effect": "entrance_fade", "order": 17, "duration": 0.45, "delay": 0.3 }
      }
