        "burn-step-3": { "effect": "entrance_wipe", "effect_options": { "direction": "right" }, "order": 5, "duration": 0.35 },
        "burn-step-4": { "effect": "entrance_wipe", "effect_options": { "direction": "right" }, "order": 6, "duration": 0.35 },
        "burn-step-5": { "effect": "entrance_wipe", "effect_options": { "direction": "right" }, "order": 7, "duration": 0.35 },
        "burn-donts": { "effect": "entrance_fade", "order": 8, "duration": 0.45, "delay": 0.3 }
      }
