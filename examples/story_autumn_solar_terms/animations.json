        },
        "p13-item-3": {
          "effect": "entrance_wipe",
          "order": 3,
          "duration": 0.25,
          "trigger": "after-previous"
        },
        "p13-item-4": {
          "effect": "entrance_wipe",
          "order": 4,
          "duration": 0.25,
          "trigger": "after-previous"
        },
        "p13-item-5": {
          "effect": "entrance_wipe",
          "order": 5,
          "duration": 0.25,
          "trigger": "after-previous"
        },
        "p13-item-6": {
          "effect": "entrance_wipe",
          "order": 6,
          "duration": 0.25,
          "trigger": "after-previous"
        }
      }
    }
  }
}