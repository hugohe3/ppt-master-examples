{
  "version": 1,
  "defaults": {
    "transition": { "effect": "fade", "duration": 0.4 },
    "animation": { "effect": "none", "duration": 0.5, "stagger": 0.2, "trigger": "after-previous" }
  },
  "slides": {
    "03_section_superposition": { "transition": { "effect": "push", "effect_options": { "direction": "left" }, "duration": 0.5 } },
    "05_section_interference": { "transition": { "effect": "push", "effect_options": { "direction": "left" }, "duration": 0.5 } },
    "10_section_diffraction": { "transition": { "effect": "push", "effect_options": { "direction": "left" }, "duration": 0.5 } },
    "13_section_light": { "transition": { "effect": "push", "effect_options": { "direction": "left" }, "duration": 0.5 } },
    "04_superposition": {
      "animation": { "trigger": "on-click" },
      "groups": {
        "stage-during": { "effect": "entrance_fade", "order": 1, "duration": 0.5 },
        "stage-after": { "effect": "entrance_fade", "order": 2, "duration": 0.5 },
        "principle": { "effect": "entrance_fade", "order": 3, "duration": 0.6 },
        "takeaway": { "effect": "entrance_fade", "order": 4, "duration": 0.5 }
      }
    },
    "08_conditions": {
      "groups": {
        "strong-label": { "effect": "entrance_fade", "order": 1, "trigger": "on-click", "duration": 0.4 },
        "formula-strong": { "effect": "entrance_fade", "order": 2, "trigger": "with-previous", "duration": 0.4 },
        "strong-note": { "effect": "entrance_fade", "order": 3, "trigger": "with-previous", "duration": 0.4 },
        "weak-label": { "effect": "entrance_fade", "order": 4, "trigger": "on-click", "duration": 0.4 },
        "formula-weak": { "effect": "entrance_fade", "order": 5, "trigger": "with-previous", "duration": 0.4 },
        "weak-note": { "effect": "entrance_fade", "order": 6, "trigger": "with-previous", "duration": 0.4 },
        "takeaway": { "effect": "entrance_fade", "order": 7, "trigger": "on-click", "duration": 0.5 }
      }
    },
    "11_diffraction_gap": {
      "animation": { "trigger": "on-click" },
      "groups": {
        "panel-wide": { "effect": "entrance_fade", "order": 1, "duration": 0.5 },
        "panel-equal": { "effect": "entrance_fade", "order": 2, "duration": 0.5 },
        "panel-narrow": { "effect": "entrance_fade", "order": 3, "duration": 0.5 },
        "condition": { "effect": "entrance_fade", "order": 4, "duration": 0.6 }
      }
    },
    "19_practice": {
      "animation": { "trigger": "on-click" },
      "groups": {
        "q1-answer": { "effect": "entrance_fade", "order": 1, "duration": 0.5 },
        "q2-answer": { "effect": "entrance_fade", "order": 2, "duration": 0.5 },
        "q3-answer": { "effect": "entrance_fade", "order": 3, "duration": 0.5 }
      }
    }
  }
}
