        "grade-internal": { "effect": "entrance_rise_up", "order": 4, "duration": 0.4 },
        "grade-sensitive": { "effect": "entrance_rise_up", "order": 5, "duration": 0.4 },
        "grade-important": { "effect": "entrance_rise_up", "order": 6, "duration": 0.4 },
        "legal-basis": { "effect": "entrance_fade", "order": 7, "delay": 0.3, "duration": 0.5 },
        "compile-note": { "effect": "entrance_fade", "order": 8, "duration": 0.4 }
      }
    },
