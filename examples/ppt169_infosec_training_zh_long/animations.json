      }
    },
    "19_ch4_cover": {
      "transition": { "effect": "morph", "effect_options": { "morph_by": "object" }, "duration": 0.8 },
      "morph": { "from": "18_export_check", "pairs": { "chapter-mark-04": { "from": "next-chapter-04", "to": "chapter-num-04" } } }
    },
    "20_law_renumber": {
      "groups": {
        "article-renumber": { "effect": "entrance_wipe", "effect_options": { "direction": "down" }, "order": 2, "duration": 1.1 },
        "effective-date-trap": { "effect": "entrance_fade", "order": 3, "delay": 0.4, "duration": 0.6 }
      }
    },
    "22_penalty_ladder": {
      "groups": {
        "penalty-matrix": { "effect": "entrance_wipe", "effect_options": { "direction": "down" }, "order": 2, "duration": 1.0 },
        "penalty-verdict": { "effect": "entrance_fade", "order": 3, "delay": 0.4, "duration": 0.6 }
      }
    },
    "23_criminal_threshold": {
      "groups": {
        "threshold-track": { "effect": "entrance_fade", "order": 2, "duration": 0.35 },
        "threshold-lodging": { "effect": "entrance_fade", "order": 3, "duration": 0.35 },
        "threshold-other": { "effect": "entrance_fade", "order": 4, "duration": 0.35 },
        "threshold-gain": { "effect": "entrance_fade", "order": 5, "duration": 0.35 },
        "halving-rule": { "effect": "entrance_wipe", "effect_options": { "direction": "right" }, "order": 6, "delay": 0.3, "duration": 0.8 },
        "case-didi": { "effect": "entrance_fade", "order": 7, "duration": 0.5 },
        "case-cnki": { "effect": "entrance_fade", "order": 8, "duration": 0.5 }
      }
    },
    "24_ch5_cover": {
      "transition": { "effect": "morph", "effect_options": { "morph_by": "object" }, "duration": 0.8 },
      "morph": { "from": "23_criminal_threshold", "pairs": { "chapter-mark-05": { "from": "next-chapter-05", "to": "chapter-num-05" } } }
    },
    "25_first_four_hours": {
      "groups": {
        "action-stop": { "effect": "entrance_fade", "order": 2, "duration": 0.45 },
        "action-report": { "effect": "entrance_fade", "order": 3, "duration": 0.45 },
        "action-record": { "effect": "entrance_fade", "order": 4, "duration": 0.45 },
        "action-cooperate": { "effect": "entrance_fade", "order": 5, "duration": 0.45 },
        "four-hour-rule": { "effect": "entrance_wipe", "effect_options": { "direction": "right" }, "order": 6, "delay": 0.3, "duration": 0.7 },
        "compile-note": { "effect": "entrance_fade", "order": 7, "duration": 0.4 }
      }
    },
    "26_report_channels": {
      "groups": {
        "report-timing": { "effect": "entrance_wipe", "effect_options": { "direction": "down" }, "order": 2, "duration": 0.9 },
        "report-precondition": { "effect": "entrance_fade", "order": 3, "delay": 0.2, "duration": 0.5 },
        "channel-label": { "effect": "entrance_fade", "order": 4, "duration": 0.4 }
      }
    },
    "27_report_immunity": {
      "groups": {
        "immunity-quote": { "effect": "entrance_fade", "order": 2, "duration": 0.7 },
        "condition-protect": { "effect": "entrance_rise_up", "order": 3, "duration": 0.45 },
        "condition-handle": { "effect": "entrance_rise_up", "order": 4, "duration": 0.45 },
        "condition-report": { "effect": "entrance_rise_up", "order": 5, "duration": 0.45 },
        "personal-takeaway": { "effect": "entrance_fade", "order": 6, "delay": 0.4, "duration": 0.7 }
      }
    },
    "28_quiz": {
      "animation": { "trigger": "on-click", "effect": "entrance_fade", "duration": 0.4 },
      "groups": {
        "page-title": { "effect": "entrance_fade", "order": 1, "trigger": "after-previous", "duration": 0.4 },
        "quiz-1": { "effect": "entrance_fade", "order": 2, "duration": 0.4 },
        "quiz-2": { "effect": "entrance_fade", "order": 3, "duration": 0.4 },
        "quiz-3": { "effect": "entrance_fade", "order": 4, "duration": 0.4 },
        "quiz-4": { "effect": "entrance_fade", "order": 5, "duration": 0.4 },
        "quiz-5": { "effect": "entrance_fade", "order": 6, "duration": 0.4 },
        "compile-note": { "effect": "entrance_fade", "order": 7, "trigger": "after-previous", "duration": 0.4 }
      }
    }
  }
}
