{
  "version": 1,
  "defaults": {
    "transition": { "effect": "fade", "duration": 0.4 },
    "animation": { "effect": "entrance_fade", "trigger": "after-previous", "duration": 0.4, "stagger": 0.25 }
  },
  "slides": {
    "02_toc": {
      "transition": { "effect": "morph", "effect_options": { "morph_by": "object" }, "duration": 0.8 },
      "morph": { "from": "01_cover", "pairs": { "year-mark": { "from": "cover-year", "to": "toc-year" } } }
    },
    "03_ch1_cover": {
      "transition": { "effect": "morph", "effect_options": { "morph_by": "object" }, "duration": 0.8 },
      "morph": { "from": "02_toc", "pairs": { "chapter-mark-01": { "from": "toc-row-1", "to": "chapter-num-01" } } }
    },
    "04_human_factor": {
      "groups": {
        "breach-root-cause": { "effect": "entrance_wheel", "order": 2, "duration": 0.9 },
        "human-factor-metric": { "effect": "entrance_fade", "order": 3, "duration": 0.5 },
        "reading-note": { "effect": "entrance_fade", "order": 4, "delay": 0.2, "duration": 0.5 },
        "takeaway": { "effect": "entrance_wipe", "effect_options": { "direction": "right" }, "order": 5, "duration": 0.6 }
      }
    },
    "05_entry_paths": {
      "groups": {
        "initial-access-vectors": { "effect": "entrance_wipe", "effect_options": { "direction": "up" }, "order": 2, "duration": 0.9 },
        "vector-takeaway": { "effect": "entrance_fade", "order": 3, "delay": 0.3, "duration": 0.5 }
      }
    },
    "06_insider_cases": {
      "groups": {
        "case-judgment": { "effect": "entrance_fade", "order": 2, "duration": 0.5 },
        "insider-cases": { "effect": "entrance_wipe", "effect_options": { "direction": "down" }, "order": 3, "duration": 0.9 },
        "scale-note": { "effect": "entrance_fade", "order": 4, "delay": 0.2, "duration": 0.5 }
      }
    },
    "08_ch2_cover": {
      "transition": { "effect": "morph", "effect_options": { "morph_by": "object" }, "duration": 0.8 },
      "morph": { "from": "07_ch1_takeaway", "pairs": { "chapter-mark-02": { "from": "next-chapter-02", "to": "chapter-num-02" } } }
    },
    "09_password_rules": {
      "groups": {
        "password-rules-compare": { "effect": "entrance_wipe", "effect_options": { "direction": "right" }, "order": 2, "duration": 1.0 },
        "password-takeaway": { "effect": "entrance_fade", "order": 3, "delay": 0.3, "duration": 0.6 }
      }
    },
    "11_phish_email": {
      "groups": {
        "phish-mail-mock": { "effect": "entrance_fade", "order": 2, "duration": 0.6 },
        "phish-tells": { "effect": "entrance_wipe", "effect_options": { "direction": "down" }, "order": 3, "duration": 0.9 },
        "phish-action": { "effect": "entrance_fade", "order": 4, "delay": 0.2, "duration": 0.5 }
      }
    },
    "12_phish_channels": {
      "groups": {
        "phish-cost-by-vector": { "effect": "entrance_wipe", "effect_options": { "direction": "right" }, "order": 5, "duration": 0.9 },
        "channel-takeaway": { "effect": "entrance_fade", "order": 6, "delay": 0.3, "duration": 0.5 }
      }
    },
    "14_ch3_cover": {
      "transition": { "effect": "morph", "effect_options": { "morph_by": "object" }, "duration": 0.8 },
      "morph": { "from": "13_ch2_takeaway", "pairs": { "chapter-mark-03": { "from": "next-chapter-03", "to": "chapter-num-03" } } }
