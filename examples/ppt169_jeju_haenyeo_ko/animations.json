        "kpi": { "effect": "entrance_fade", "trigger": "after-previous", "delay": 0.2, "duration": 0.6 }
      }
    },
    "05_상군_중군_하군": {
      "groups": {
        "career-diagram": { "effect": "entrance_wipe", "effect_options": { "direction": "left" }, "trigger": "after-previous", "delay": 0.2, "duration": 1.2 }
