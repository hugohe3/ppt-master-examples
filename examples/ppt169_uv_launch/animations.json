      }
    },
    "09_proof_point": {
      "groups": {
        "p09-header": { "effect": "entrance_fade", "order": 1, "duration": 0.3 },
        "astral-speedup-claim": { "effect": "entrance_wipe", "effect_options": { "direction": "up" }, "order": 2, "duration": 0.7 },
        "p09-basis": { "effect": "entrance_fade", "order": 3, "duration": 0.4 }
      }
    },
    "10_capability_landscape": {
      "groups": {
        "p10-header": { "effect": "entrance_fade", "order": 1, "duration": 0.3 },
        "p10-sections": { "effect": "entrance_wipe", "effect_options": { "direction": "down" }, "order": 2, "duration": 0.7 }
      }
    },
    "11_shipped_vs_preview": {
      "groups": {
        "p11-header": { "effect": "entrance_fade", "order": 1, "duration": 0.3 },
        "capability-status-matrix": { "effect": "entrance_wipe", "effect_options": { "direction": "down" }, "order": 2, "duration": 0.7 },
        "p11-preview-usage": { "effect": "entrance_fade", "order": 3, "duration": 0.4 }
      }
    },
    "12_availability": {
      "groups": {
        "p12-header": { "effect": "entrance_fade", "order": 1, "duration": 0.3 },
        "p12-install-unix": { "effect": "entrance_fade", "order": 2, "duration": 0.4 },
        "p12-install-win": { "effect": "entrance_fade", "order": 3, "duration": 0.4 }
      }
    },
    "13_sources": {
      "groups": {
        "p13-header": { "effect": "entrance_fade", "order": 1, "duration": 0.3 },
        "p13-sources": { "effect": "entrance_wipe", "effect_options": { "direction": "down" }, "order": 2, "duration": 0.7 }
      }
    },
    "14_next_step": {
      "groups": {
        "p14-header": { "effect": "entrance_fade", "order": 1, "duration": 0.3 },
        "p14-terminal": { "effect": "entrance_fade", "order": 2, "duration": 0.5 },
        "p14-close": { "effect": "entrance_fade", "order": 3, "duration": 0.6 }
      }
    }
  }
}
